DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=sababisha
POSTGRES_USER=sababisha
POSTGRES_PASSWORD=sababisha-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PostgreSQL is the default. SQLite is available only for a quick local preview.
USE_SQLITE=False

# Production HTTPS settings. Enable TRUST_X_FORWARDED_PROTO only when a trusted
# reverse proxy supplies the X-Forwarded-Proto header.
# TRUST_X_FORWARDED_PROTO=True
